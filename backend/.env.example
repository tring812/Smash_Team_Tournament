# Sao chép thành .env (đã .gitignore). Giá trị thật lấy từ secret manager, KHÔNG commit.
NODE_ENV=development
PORT=5100
# Database riêng của web giải.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/smashteam_tournament
# Không có Docker/Postgres? Dùng PGlite (Postgres WASM trong tiến trình) — CHỈ DEV:
# DATABASE_URL=pglite:.pgdata
# Khoá ký cookie phiên, >= 32 ký tự: openssl rand -base64 48
SESSION_SECRET=
PUBLIC_ORIGIN=http://localhost:3100
LOG_LEVEL=info
# CHỈ DEV: bật nút "Dev: Admin / Dev: Trọng tài" (đăng nhập 1 chạm). Bị từ chối ở production.
# DEV_LOGIN=1
